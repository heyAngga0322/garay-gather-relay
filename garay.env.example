# garay.env.example - Environment file for Garay systemd service
# Copy to /etc/garay/garay.env and customize
# Required: chmod 600 /etc/garay/garay.env

# Server binding
GARAY__BIND_ADDRESS=0.0.0.0:3000

# TLS configuration (terminate TLS at reverse proxy in production)
GARAY__TLS_ENABLED=false
# GARAY__TLS__CERT_PATH=/etc/garay/certs/server.crt
# GARAY__TLS__KEY_PATH=/etc/garay/certs/server.key
# GARAY__TLS__AUTO_GENERATE=false

# TURN/STUN configuration
# GARAY__TURN__URLS=["turn:turn.garay.local:3478?transport=udp", "turns:turn.garay.local:5349?transport=tcp"]
# GARAY__TURN__USERNAME=garay-user
# GARAY__TURN__CREDENTIAL=your-turn-password

# Room capacity
GARAY__MAX_PEERS_PER_ROOM=4

# Logging
GARAY__LOG_FORMAT=json
GARAY__LOG_LEVEL=info

# Allowed origins for WebSocket connections (comma-separated)
# REQUIRED in production
WEBRTC_ALLOWED_ORIGINS=https://meet.example.com,https://meet-staging.example.com

# Application environment
APP_ENV=production